* Fixed-mismatch 128-RO PVT reliability experiment
* Virtual chip: 079
* Bank A: RO0-RO63; Bank B: RO64-RO127
* Every transistor DELVTO is numerical and remains fixed over PVT.

.include "45nm_HP.pm"
.include "chip_079_mismatch.inc"
.options plotwinsize=0 numdgt=10 reltol=1e-4 abstol=1e-12 vntol=1e-6

.param VDDVAL=1.0
.param VTHRESH={VDDVAL/2}
.param TSTOP=4.0000000000000001e-08
.param MAXSTEP=2.0000000000000000e-12

.subckt INV_FIXED in out vdd vss params: DVN=0 DVP=0
MN out in vss vss nmos W=200n L=50n delvto={DVN}
MP out in vdd vdd pmos W=400n L=50n delvto={DVP}
.ends INV_FIXED

.subckt RO7_FIXED OUT VDD VSS params: DVN0=0 DVN1=0 DVN2=0 DVN3=0 DVN4=0 DVN5=0 DVN6=0 DVP0=0 DVP1=0 DVP2=0 DVP3=0 DVP4=0 DVP5=0 DVP6=0
X1 OUT n2 VDD VSS INV_FIXED params: DVN={DVN0} DVP={DVP0}
X2 n2 n3 VDD VSS INV_FIXED params: DVN={DVN1} DVP={DVP1}
X3 n3 n4 VDD VSS INV_FIXED params: DVN={DVN2} DVP={DVP2}
X4 n4 n5 VDD VSS INV_FIXED params: DVN={DVN3} DVP={DVP3}
X5 n5 n6 VDD VSS INV_FIXED params: DVN={DVN4} DVP={DVP4}
X6 n6 n7 VDD VSS INV_FIXED params: DVN={DVN5} DVP={DVP5}
X7 n7 OUT VDD VSS INV_FIXED params: DVN={DVN6} DVP={DVP6}
CSTART OUT VSS 1f IC=0
.ends RO7_FIXED

VDD VDD 0 {VDDVAL}
VSS VSS 0 0

XRO0 ro0_out VDD VSS RO7_FIXED params: DVN0={DVN_R000_S0} DVN1={DVN_R000_S1} DVN2={DVN_R000_S2} DVN3={DVN_R000_S3} DVN4={DVN_R000_S4} DVN5={DVN_R000_S5} DVN6={DVN_R000_S6}
