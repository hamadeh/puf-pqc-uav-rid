lemma no_commit_after_root_revocation:
  all-traces
  "∀ vnew version #r #i.
    (((RootRevoked( 'domain0', vnew ) @ #r) ∧
      (CommitAccepted( 'domain0', version ) @ #i)) ∧
     (#r < #i)) ⇒
    (⊥)"
/*
guarded formula characterizing all counter-examples:
"∃ vnew version #r #i.
  (RootRevoked( 'domain0', vnew ) @ #r) ∧
  (CommitAccepted( 'domain0', version ) @ #i)
 ∧
  #r < #i"
*/
by sorry

