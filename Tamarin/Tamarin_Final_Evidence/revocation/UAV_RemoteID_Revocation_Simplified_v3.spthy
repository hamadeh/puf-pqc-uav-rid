theory UAV_RemoteID_Revocation_Simplified_v3

begin

/*
 * Single-domain bounded revocation-state abstraction.
 *
 * The cryptographic protocol is proved separately in the core theory.
 * This theory verifies only revocation-version consistency and fail-closed
 * behavior for one representative credential domain. Public constants are
 * symbolic identifiers, not secrets. A uniqueness restriction permits one
 * initialization event, eliminating unbounded independent setup instances.
 */

rule Initialize:
  [ ]
  --[ Initialized('domain0'),
      VersionInstalled('domain0','v0') ]->
  [ CredentialState('domain0','v0','active','active','active'),
    CanRefresh('domain0'),
    CommitPermit('domain0','c0'),
    CommitPermit('domain0','c1') ]

restriction UniqueInitialization:
  "All #i #j.
      Initialized('domain0') @ #i
    & Initialized('domain0') @ #j
      ==> #i = #j"

/* One representative version refresh while all credentials remain active. */
rule Refresh_Version:
  [ CredentialState('domain0',version,
                    rootStatus,verifierStatus,keyStatus),
    CanRefresh('domain0') ]
  --[ VersionRefreshed('domain0',version,'v1'),
      VersionInstalled('domain0','v1') ]->
  [ CredentialState('domain0','v1',
                    rootStatus,verifierStatus,keyStatus) ]

/* Two one-use permits bound the model while allowing commits on both sides
 * of the representative version refresh.
 */
rule Commit:
  [ CredentialState('domain0',version,
                    'active','active','active'),
    CommitPermit('domain0',permit) ]
  --[ RevocationChecked('domain0',version),
      CommitAccepted('domain0',version) ]->
  [ CredentialState('domain0',version,
                    'active','active','active') ]

rule Revoke_Root:
  [ CredentialState('domain0',version,
                    'active',verifierStatus,keyStatus) ]
  --[ RootRevoked('domain0','v-root-revoked'),
      VersionInstalled('domain0','v-root-revoked') ]->
  [ CredentialState('domain0','v-root-revoked',
                    'revoked',verifierStatus,keyStatus) ]

rule Revoke_Verifier:
  [ CredentialState('domain0',version,
                    rootStatus,'active',keyStatus) ]
  --[ VerifierRevoked('domain0','v-verifier-revoked'),
      VersionInstalled('domain0','v-verifier-revoked') ]->
  [ CredentialState('domain0','v-verifier-revoked',
                    rootStatus,'revoked',keyStatus) ]

rule Revoke_UAV_Key:
  [ CredentialState('domain0',version,
                    rootStatus,verifierStatus,'active') ]
  --[ UAVKeyRevoked('domain0','v-uav-key-revoked'),
      VersionInstalled('domain0','v-uav-key-revoked') ]->
  [ CredentialState('domain0','v-uav-key-revoked',
                    rootStatus,verifierStatus,'revoked') ]

lemma commit_reachable:
  exists-trace
  "Ex version #i.
      CommitAccepted('domain0',version) @ #i"

lemma commit_after_version_refresh_reachable:
  exists-trace
  "Ex oldVersion #r #i.
      VersionRefreshed('domain0',oldVersion,'v1') @ #r
    & CommitAccepted('domain0','v1') @ #i
    & #r < #i"

lemma two_commits_across_version_refresh_reachable:
  exists-trace
  "Ex #c0 #r #c1.
      CommitAccepted('domain0','v0') @ #c0
    & VersionRefreshed('domain0','v0','v1') @ #r
    & CommitAccepted('domain0','v1') @ #c1
    & #c0 < #r
    & #r < #c1"

lemma commit_uses_latest_installed_version:
  "All version #i.
      CommitAccepted('domain0',version) @ #i
      ==> Ex #v.
          VersionInstalled('domain0',version) @ #v
        & #v < #i
        & not (Ex newer #n.
              VersionInstalled('domain0',newer) @ #n
            & #v < #n
            & #n < #i)"

lemma no_commit_after_root_revocation:
  "All vnew version #r #i.
      RootRevoked('domain0',vnew) @ #r
    & CommitAccepted('domain0',version) @ #i
    & #r < #i
      ==> F"

lemma no_commit_after_verifier_revocation:
  "All vnew version #r #i.
      VerifierRevoked('domain0',vnew) @ #r
    & CommitAccepted('domain0',version) @ #i
    & #r < #i
      ==> F"

lemma no_commit_after_uav_key_revocation:
  "All vnew version #r #i.
      UAVKeyRevoked('domain0',vnew) @ #r
    & CommitAccepted('domain0',version) @ #i
    & #r < #i
      ==> F"

end
