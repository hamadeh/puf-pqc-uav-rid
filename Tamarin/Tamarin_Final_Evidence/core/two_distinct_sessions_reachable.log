rule (modulo E) Reveal_Passive_Storage:
   [ !FlashImage( $D, rootID, root, pkD, scope, version, authBody, authSig )
   ]
  --[ FlashDisclosure( $D, rootID ) ]->
   [ Out( <rootID, root, pkD, scope, version, authBody, authSig> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Active_Capture:
   [
   !UAVKey( $D, skD, pkD, keyID ),
   !LeafPath( $D, rootID, root, pid0, '0', sib0, 'P0' ),
   !LeafPath( $D, rootID, root, pid1, '1', sib1, 'P1' )
   ]
  --[ ActiveCapture( $D ) ]->
   [ Out( <skD, rootID, root, pid0, sib0, pid1, sib1> ) ]

  /* has exactly the trivial AC variant */

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

lemma commit_reachable:
  exists-trace
  "∃ V D rootID root pid idx nv reqID tsV tsD th scope #i.
    VerifierCommit( V, D, rootID, root, pid, idx, nv, reqID, tsV, tsD, th,
                    scope
    ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ V D rootID root pid idx nv reqID tsV tsD th scope #i.
  (VerifierCommit( V, D, rootID, root, pid, idx, nv, reqID, tsV, tsD, th,
                   scope
   ) @ #i)"
*/
by sorry

lemma two_distinct_sessions_reachable:
  exists-trace
  "∃ V D rootID root pid0 pid1 nv0 nv1 req0 req1 tsV0 tsV1 tsD0 tsD1 th0
     th1 scope #i #j.
    ((VerifierCommit( V, D, rootID, root, pid0, '0', nv0, req0, tsV0, tsD0,
                      th0, scope
      ) @ #i) ∧
     (VerifierCommit( V, D, rootID, root, pid1, '1', nv1, req1, tsV1, tsD1,
                      th1, scope
      ) @ #j)) ∧
    (¬(req0 = req1))"
/*
guarded formula characterizing all satisfying traces:
"∃ V D rootID root pid0 pid1 nv0 nv1 req0 req1 tsV0 tsV1 tsD0 tsD1 th0
   th1 scope #i #j.
  (VerifierCommit( V, D, rootID, root, pid0, '0', nv0, req0, tsV0, tsD0,
                   th0, scope
   ) @ #i) ∧
  (VerifierCommit( V, D, rootID, root, pid1, '1', nv1, req1, tsV1, tsD1,
                   th1, scope
   ) @ #j)
 ∧
  ¬(req0 = req1)"
*/
simplify
solve( VerifierCommit( V, D, rootID, root, pid0, '0', nv0, req0, tsV0,
                       tsD0, th0, scope
       ) @ #i )
  case Verifier_Accept_P0
  solve( VerifierState( $V, $D,
                        h(<
                           <'ROOT-AUTH-v1', pk(x), h(<'NODE', h(<'LEAF', pid0, '0'>), sibling>), 
                            scope, 'v0'>, 
                           sign(<'ROOT-AUTH-v1', pk(x), 
                                 h(<'NODE', h(<'LEAF', pid0, '0'>), sibling>), scope, 'v0'>,
                                x.1)
                          >),
                        pid0, '0', nv0, req0, req, dkV, tsV0, scope
         ) ▶₀ #i )
    case Verifier_Request
    solve( !TAPub( pk(~skTA) ) ▶₁ #i )
      case Setup
      solve( !VerifierDB( $V, $D,
                          h(<
