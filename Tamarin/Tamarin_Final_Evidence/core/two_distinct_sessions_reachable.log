lemma request_authentication:
  all-traces
  "∀ V D rootID pid idx nv reqID tsV scope #i.
    (RequestAuthenticated( V, D, rootID, pid, idx, nv, reqID, tsV, scope
     ) @ #i) ⇒
    (∃ #j.
      (RequestSent( V, D, rootID, pid, idx, nv, reqID, tsV, scope ) @ #j) ∧
      (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ V D rootID pid idx nv reqID tsV scope #i.
  (RequestAuthenticated( V, D, rootID, pid, idx, nv, reqID, tsV, scope
   ) @ #i)
 ∧
  ∀ #j.
   (RequestSent( V, D, rootID, pid, idx, nv, reqID, tsV, scope ) @ #j)
  ⇒
   ¬(#j < #i)"
*/
by sorry

